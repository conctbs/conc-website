---
import '../assets/styles/tailwind.css';

import ConsentModeHead from '~/components/analytics/ConsentModeHead.astro';
import CookieConsentBanner from '~/components/analytics/CookieConsentBanner.astro';
import AnnouncementPopup from '~/components/AnnouncementPopup.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { I18N, SITE } from '~/theme-config';
import { DEMO_MODE } from '~/lib/api';
import { getCanonical } from '~/utils/permalinks';

const { title, seo = null, siteSetting = null } = Astro.props;
const pageTitle = title ?? siteSetting?.siteName ?? SITE.name;
const pageDescription = seo?.metaDescription ?? siteSetting?.siteDescription ?? null;
const canonicalPath = seo?.canonicalUrl
  ? `${new URL(seo.canonicalUrl, SITE.site).pathname}${new URL(seo.canonicalUrl, SITE.site).search}`
  : String(Astro.url.pathname);
const canonical = String(getCanonical(canonicalPath));
const gtmId = DEMO_MODE ? '' : (import.meta.env.PUBLIC_GTM_ID?.trim() ?? '');
---

<!doctype html>
<html lang={I18N.language} dir={I18N.textDirection} class="2xl:text-[20px]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
    <meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
    <Favicons />
    <CustomStyles />
    {DEMO_MODE ? <script is:inline src="/conc-demo.js"></script> : <ConsentModeHead />}
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${encodeURIComponent(gtmId)}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          ></iframe>
        </noscript>
      )
    }
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-white focus:px-4 focus:py-3 focus:text-red-800">Skip to content</a>
    <Announcement />
    <Header {...headerData} isSticky />
    <main id="main-content">
      {DEMO_MODE && (
        <div class="border-b border-red-100 bg-red-50 text-stone-800">
          <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-5 gap-y-2 px-4 py-3 text-sm md:px-6">
            <p><strong class="text-red-800">Demo mode</strong> <span class="ml-2">Use sample information only. No emails or payments are sent.</span></p>
            <a class="font-semibold text-red-800 underline underline-offset-4" href="/member-login">Try the member portal</a>
          </div>
        </div>
      )}
      <slot />
    </main>
    <Footer {...footerData} />
    <AnnouncementPopup />
    {!DEMO_MODE && <CookieConsentBanner />}
    <BasicScripts />
  </body>
</html>
