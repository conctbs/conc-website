---
import PageCover from "../components/PageCover.astro";
import StructuredPageContent from "../components/StructuredPageContent.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { getAnnouncements, getPageBySlug, getSiteSetting } from "../lib/api";

const [page, siteSetting, announcements] = await Promise.all([
  getPageBySlug("announcement"),
  getSiteSetting(),
  getAnnouncements(),
]);
const title = page?.seo?.metaTitle ?? page?.title ?? "Announcement | CONC";

const categoryLabel = {
  general: "General",
  program: "Program",
  registration: "Registration",
  service: "Service",
  urgent: "Urgent",
};

const formatDate = (value: string | null) => {
  if (!value) return null;

  return new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(new Date(value));
};

const stripHtml = (value: string | null) =>
  value?.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim() ?? null;
---

<MainLayout title={title} seo={page?.seo} siteSetting={siteSetting}>
  {page ? (
    <StructuredPageContent sections={page.sections} fallbackEyebrow="News & Events" fallbackTitle="Announcement" />
  ) : (
    <>
      <section class="border-b border-stone-200 bg-white">
        <div class="mx-auto grid max-w-7xl gap-8 px-4 py-16 md:px-6 md:py-20 lg:grid-cols-[minmax(0,1.08fr)_minmax(19rem,0.92fr)] lg:items-end">
          <div class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-700">News & Events</p>
            <h1 class="mt-4 text-4xl font-semibold leading-tight text-stone-900 md:text-6xl">Announcement</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
              Official notices, scheduling updates, registration windows, and public information that should remain visible outside the standard news feed.
            </p>
          </div>
          <PageCover eyebrow="Announcements" title="Important updates, participation notices, and public service information" theme="programs" />
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-4 py-14 md:px-6">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)]">
          <article class="rounded-[1.75rem] border border-stone-200 bg-white p-7">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-700">Current Updates</p>
            <p class="mt-4 text-base leading-8 text-stone-600">
              Use this page for time-sensitive notices such as schedule changes, open calls, registration deadlines, or service-related public updates.
            </p>
          </article>
          <div class="grid gap-4">
            <a class="rounded-[1.5rem] border border-stone-200 bg-white px-5 py-4 font-semibold text-stone-900 transition hover:border-red-700 hover:text-red-700" href="/news">News</a>
            <a class="rounded-[1.5rem] border border-stone-200 bg-white px-5 py-4 font-semibold text-stone-900 transition hover:border-red-700 hover:text-red-700" href="/event-calendar">Event Calendar</a>
            <a class="rounded-[1.5rem] border border-stone-200 bg-white px-5 py-4 font-semibold text-stone-900 transition hover:border-red-700 hover:text-red-700" href="/programs">Programs</a>
          </div>
        </div>
      </section>
    </>
  )}

  <section class="border-t border-stone-200 bg-stone-50">
    <div class="mx-auto max-w-7xl px-4 py-14 md:px-6 md:py-16">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-red-700">Database Announcements</p>
          <h2 class="mt-3 text-3xl font-semibold text-stone-950 md:text-4xl">Latest public notices</h2>
        </div>
        <a class="text-sm font-semibold text-red-700 transition hover:text-red-900" href="/news">
          View news archive
          <span class="ml-1">→</span>
        </a>
      </div>

      {announcements.length > 0 ? (
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {announcements.map((item) => {
            const summary = item.summary ?? stripHtml(item.content) ?? "Published announcement from the CONC backend.";
            const dateLabel = formatDate(item.publishedDate);
            const category = item.category ? categoryLabel[item.category] : "Announcement";
            const href = item.linkUrl || null;

            return (
              <article class:list={[
                "flex min-h-72 flex-col rounded-[1.5rem] border bg-white p-6 shadow-sm",
                item.featured ? "border-red-200 ring-1 ring-red-100" : "border-stone-200",
              ]}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full border border-red-700 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-red-700">
                    {category}
                  </span>
                  {item.featured && (
                    <span class="rounded-full bg-stone-950 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-white">
                      Featured
                    </span>
                  )}
                </div>
                <h3 class="mt-5 text-2xl font-semibold leading-snug text-stone-950">{item.title}</h3>
                <p class="mt-4 line-clamp-4 text-sm leading-7 text-stone-600">{summary}</p>
                <div class="mt-auto pt-6">
                  {dateLabel && <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">{dateLabel}</p>}
                  {href && (
                    <a class="mt-3 inline-flex text-sm font-semibold text-red-700 transition hover:text-red-900" href={href}>
                      {item.linkLabel || "Read announcement"}
                      <span class="ml-2">→</span>
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="mt-8 rounded-[1.5rem] border border-dashed border-stone-300 bg-white p-8 text-stone-600">
          No published announcements are available yet.
        </div>
      )}
    </div>
  </section>
</MainLayout>
